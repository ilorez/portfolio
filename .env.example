# Contact form – Brevo SMTP
# 1. Copy this file:  cp .env.example .env.local
# 2. In .env.local, replace the placeholders below with your real values.
# 3. Never commit .env.local (it's in .gitignore).

# --- Where to receive contact messages (your inbox) ---
CONTACT_TO_EMAIL=here-your-email@gmail.com

# --- Brevo SMTP (smtp-relay.brevo.com, port 587) ---
# Login from Brevo → SMTP & API → SMTP → "Login"
SMTP_USER=here-stm-user-name@gmail.com

# SMTP key from Brevo → SMTP & API → SMTP → "SMTP key" (paste the full key here)
SMTP_PASS=paste-your-brevo-smtp-key-here

# Server and port (no need to change for Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=port-number
SMTP_SECURE=false

# "From" address shown in received emails (use your real email or noreply@…)
SMTP_FROM=here-your-email@gmail.com

# --- Sanity CMS ---
NEXT_PUBLIC_SANITY_PROJECT_ID=project-id
NEXT_PUBLIC_SANITY_DATASET=dataset-name
